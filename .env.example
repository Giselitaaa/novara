# ────────────────────────────────────────────────────────────
# NOVARA — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# Nunca subir .env con valores reales al repositorio.
# ────────────────────────────────────────────────────────────

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/novara?schema=public"
# URL directa sin pooler, requerida por Prisma Migrate en algunos proveedores:
DIRECT_URL="postgresql://user:password@localhost:5432/novara?schema=public"

# --- Auth.js ---
# Generar con: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Proveedores OAuth (opcional, según se activen)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# --- Asistente de IA (panel de administración) ---
# Proveedor activo: "anthropic" (por defecto), "openai" o "local".
# Cambiar de proveedor es solo cambiar esta variable — ver
# src/modules/ai/server/provider.ts
#
# OPCIÓN DE COSTE CERO: AI_PROVIDER="local" usa un LLM LOCAL con protocolo
# OpenAI-compatible (Ollama o el servidor de llama.cpp). No necesita ninguna
# clave de pago. Arranca el runtime local (p. ej. `ollama serve` +
# `ollama pull llama3.1`) y define LOCAL_AI_BASE_URL/AI_MODEL. Si el servidor
# local no está arrancado, el asistente degrada con honestidad (nunca inventa).
AI_PROVIDER="anthropic"
AI_MODEL=""                        # local: nombre del modelo, p. ej. "llama3.1"
LOCAL_AI_BASE_URL=""               # local: por defecto http://localhost:11434/v1 (Ollama)
LOCAL_AI_API_KEY=""                # local: opcional; muchos servidores locales lo ignoran
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Voz / Text-to-Speech (flashcards, listening, speaking) ---
# Proveedor de voz: "openai" (por defecto) o "piper".
#
# OPCIÓN DE COSTE CERO: VOICE_PROVIDER="piper" usa Piper (motor TTS local,
# licencia MIT) servido por HTTP local (PIPER_URL). No necesita clave de pago.
# Aviso: cada modelo de voz tiene su licencia; usa solo voces de uso comercial
# permitido (ver AUDIO_TTS_STT_RESEARCH.md). Sin proveedor configurado, la
# generación de audio se ofrece como NO disponible; nunca se finge.
VOICE_PROVIDER="openai"
VOICE_MODEL=""            # openai: por defecto "tts-1"
VOICE_DEFAULT_VOICE=""    # openai: "alloy"; piper: p. ej. "en_US-lessac-medium"
PIPER_URL=""              # piper: URL del servicio Piper local, p. ej. http://localhost:5000

# --- Speaking conversacional (reconocimiento de voz + IA) ---
# La conversación y la evaluación usan el proveedor de IA (arriba; puede ser
# "local"). El reconocimiento de voz (Speech-to-Text): STT_PROVIDER="openai"
# (Whisper cloud) o "whisper-local".
#
# OPCIÓN DE COSTE CERO: STT_PROVIDER="whisper-local" usa Whisper local
# (whisper.cpp / faster-whisper) por HTTP (WHISPER_URL), sin clave de pago.
STT_PROVIDER="openai"
STT_MODEL=""             # por defecto "whisper-1"
WHISPER_URL=""           # whisper-local: base del servicio, p. ej. http://localhost:9000/v1

# --- Correo transaccional (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="NOVARA <hola@novara.academy>"

# --- Almacenamiento de archivos ---
# STORAGE_PROVIDER: vacío/"s3" (por defecto, S3/Cloudflare R2) o "local".
# OPCIÓN DE COSTE CERO: STORAGE_PROVIDER="local" guarda los archivos (p. ej. los
# audios TTS) en public/uploads y los sirve en /uploads. Requiere disco
# persistente (no sirve en hosts con public/ inmutable como Vercel).
STORAGE_PROVIDER=""
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# --- Streaming de vídeo (Mux / Cloudflare Stream) ---
VIDEO_PROVIDER_TOKEN_ID=""
VIDEO_PROVIDER_TOKEN_SECRET=""

# --- Pagos ---
# Proveedor activo: "manual" (Bizum/transferencia, por defecto) o "stripe".
# El flujo manual funciona sin ninguna clave. Para activar Stripe:
# cambiar a "stripe", instalar el SDK (npm i stripe) y rellenar las
# claves de abajo. Sin ellas, Stripe falla de forma explícita, nunca
# finge un cobro. Ver src/modules/payments/server/providers/.
PAYMENT_PROVIDER="manual"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Tareas programadas (cron) ---
# Token que protege /api/cron/retention (emails a alumnos inactivos).
# Sin este valor, el barrido de retención está deshabilitado. Programar
# una llamada diaria: curl -H "Authorization: Bearer $CRON_SECRET" .../api/cron/retention
CRON_SECRET=""

# --- Aplicación ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NOVARA"
NODE_ENV="development"
