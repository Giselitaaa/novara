# ────────────────────────────────────────────────────────────
# NOVARA — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# Nunca subir .env con valores reales al repositorio.
# ────────────────────────────────────────────────────────────

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/novara?schema=public"
# URL directa sin pooler, requerida por Prisma Migrate en algunos proveedores:
DIRECT_URL="postgresql://user:password@localhost:5432/novara?schema=public"

# --- Auth.js ---
# Generar con: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Proveedores OAuth (opcional, según se activen)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# --- Asistente de IA (panel de administración) ---
# Proveedor activo: "anthropic" (por defecto) u "openai". Cambiar de
# proveedor es solo cambiar esta variable — ver
# src/modules/ai/server/provider.ts
AI_PROVIDER="anthropic"
AI_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Voz / Text-to-Speech (flashcards, listening, speaking) ---
# Proveedor de voz: "openai" (por defecto). Añadir otro (ElevenLabs,
# Azure, Polly) es una implementación más en src/modules/voice/server.
# Sin OPENAI_API_KEY (arriba), la generación de audio se ofrece como NO
# disponible; nunca se finge. Con almacenamiento configurado, los audios
# se cachean por hash del texto y no se regeneran (ni se re-facturan).
VOICE_PROVIDER="openai"
VOICE_MODEL=""            # por defecto "tts-1"
VOICE_DEFAULT_VOICE=""    # por defecto "alloy"

# --- Speaking conversacional (reconocimiento de voz + IA) ---
# La conversación y la evaluación usan el proveedor de IA (arriba). El
# reconocimiento de voz (Speech-to-Text) usa OPENAI_API_KEY con Whisper por
# defecto; preparado para Google/Azure cambiando STT_PROVIDER. Sin claves,
# el speaking se ofrece como NO disponible; nunca se simula.
STT_PROVIDER="openai"
STT_MODEL=""             # por defecto "whisper-1"

# --- Correo transaccional (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="NOVARA <hola@novara.academy>"

# --- Almacenamiento de archivos (S3 / Cloudflare R2) ---
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# --- Streaming de vídeo (Mux / Cloudflare Stream) ---
VIDEO_PROVIDER_TOKEN_ID=""
VIDEO_PROVIDER_TOKEN_SECRET=""

# --- Pagos ---
# Proveedor activo: "manual" (Bizum/transferencia, por defecto) o "stripe".
# El flujo manual funciona sin ninguna clave. Para activar Stripe:
# cambiar a "stripe", instalar el SDK (npm i stripe) y rellenar las
# claves de abajo. Sin ellas, Stripe falla de forma explícita, nunca
# finge un cobro. Ver src/modules/payments/server/providers/.
PAYMENT_PROVIDER="manual"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Tareas programadas (cron) ---
# Token que protege /api/cron/retention (emails a alumnos inactivos).
# Sin este valor, el barrido de retención está deshabilitado. Programar
# una llamada diaria: curl -H "Authorization: Bearer $CRON_SECRET" .../api/cron/retention
CRON_SECRET=""

# --- Aplicación ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NOVARA"
NODE_ENV="development"
