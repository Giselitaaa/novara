generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  passwordHash       String?                 @map("password_hash")
  emailVerifiedAt    DateTime?               @map("email_verified_at")
  statusId           String                  @map("status_id")
  lastLoginAt        DateTime?               @map("last_login_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  deletedAt          DateTime?               @map("deleted_at")
  activityLogs       ActivityLog[]
  referral           AffiliateReferral?
  affiliate          Affiliate?
  auditLogs          AuditLog[]
  authProviders      AuthProvider[]
  authoredCourses    Author?
  blogPosts          BlogPost[]
  certificates       Certificate[]
  courseProgress     CourseProgressSummary[]
  courseAnswers      CourseQuestionAnswer[]
  courseQuestions    CourseQuestion[]
  emailLogs          EmailLog[]
  enrollments        Enrollment[]
  examAttempts       ExamAttempt[]
  favorites          Favorite[]
  legalConsents      LegalConsent[]
  lessonNotes        LessonNote[]
  lessonProgress     LessonProgress[]
  notifications      Notification[]
  paymentsReviewed   Payment[]               @relation("PaymentReviewer")
  payments           Payment[]
  refundsProcessed   Refund[]                @relation("RefundProcessor")
  uploadedResources  Resource[]
  reviews            Review[]
  streak             Streak?
  supportMessages    SupportMessage[]
  supportTickets     SupportTicket[]
  userBadges         UserBadge[]
  profile            UserProfile?
  roles              UserRole[]
  sessions           UserSession[]
  status             UserStatus              @relation(fields: [statusId], references: [id])
  verificationTokens VerificationToken[]
  xpTransactions     XPTransaction[]
  exerciseSubmissions     ExerciseSubmission[]
  finalProjectSubmissions CourseFinalProjectSubmission[]
  flashcardDecks          FlashcardDeck[]
  exerciseAttempts        ExerciseAttempt[]

  @@map("users")
}

/// Catálogo — estados de cuenta. Tabla y no enum: permite matizar
/// estados a futuro (ej. "en periodo de prueba") sin migración estructural.
model UserStatus {
  id    String @id @default(uuid())
  key   String @unique
  label String
  users User[]

  @@map("user_statuses")
}

/// Un usuario puede tener varios métodos de acceso sin duplicar User.
model AuthProvider {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("auth_providers")
}

model UserProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("user_id")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  avatarUrl          String?   @map("avatar_url")
  bio                String?
  country            String?
  timezone           String?
  weeklyGoalMinutes  Int       @default(180) @map("weekly_goal_minutes")
  showInRanking      Boolean   @default(true) @map("show_in_ranking")
  acceptsMarketing   Boolean   @default(true) @map("accepts_marketing")
  localePreferenceId String?   @map("locale_preference_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  localePreference   Language? @relation(fields: [localePreferenceId], references: [id])
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Catálogo de roles — añadir un rol nuevo es una fila, no una migración.
model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Pivote user↔role: permite múltiples roles por usuario en el futuro
/// (ej. alumno que también es editor de contenido) sin rehacer nada.
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Trazabilidad RGPD: qué versión de qué documento aceptó cada usuario.
model LegalConsent {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  documentType    String   @map("document_type")
  documentVersion String   @map("document_version")
  acceptedAt      DateTime @default(now()) @map("accepted_at")
  ipAddress       String?  @map("ip_address")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("legal_consents")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @updatedAt @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

/// Tokens de un solo uso para flujos propios de autenticación
/// (verificación de email, recuperación de contraseña). Deliberadamente
/// NO es la tabla genérica `VerificationToken` (identifier+token) que
/// espera un adaptador estándar de Auth.js: al vincular cada token a un
/// `userId` y a un `type` explícito, se pueden emitir varios tokens de
/// tipos distintos para el mismo usuario sin colisión, y se audita
/// cuándo se usó cada uno.
model VerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  type      String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

/// Catálogo genérico reutilizable (activo/inactivo/archivado...) para no
/// repetir booleanos ad-hoc en cada tabla.
model Status {
  id              String           @id @default(uuid())
  key             String           @unique
  label           String
  banners         Banner[]
  blogPosts       BlogPost[]
  categories      Category[]
  courseQuestions CourseQuestion[]
  homeBlocks      HomePageBlock[]
  learningPaths   LearningPath[]
  reviews         Review[]
  supportTickets  SupportTicket[]

  @@map("statuses")
}

/// Autorreferenciada → categorías y subcategorías ilimitadas en profundidad.
model Category {
  id              String           @id @default(uuid())
  parentId        String?          @map("parent_id")
  name            String
  slug            String           @unique
  icon            String?
  imageUrl        String?          @map("image_url")
  color           String?
  sortOrder       Int              @default(0) @map("sort_order")
  statusId        String           @map("status_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  parent          Category?        @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryToSubcategory")
  status          Status           @relation(fields: [statusId], references: [id])
  courseQuestions CourseQuestion[] @relation("CourseQuestionCategory")
  courses         Course[]
  questions       Question[]

  @@map("categories")
}

model Tag {
  id      String      @id @default(uuid())
  name    String      @unique
  slug    String      @unique
  courses CourseTag[]

  @@map("tags")
}

model CourseTag {
  courseId String @map("course_id")
  tagId    String @map("tag_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
  @@map("course_tags")
}

/// Entidad "profesor" desde el día uno, aunque hoy el único autor sea
/// NOVARA. Evita tener que tocar Course cuando haya autores externos.
model Author {
  id               String   @id @default(uuid())
  userId           String?  @unique @map("user_id")
  displayName      String   @map("display_name")
  bio              String?
  avatarUrl        String?  @map("avatar_url")
  isPlatformAuthor Boolean  @default(false) @map("is_platform_author")
  user             User?    @relation(fields: [userId], references: [id])
  courses          Course[]

  @@map("authors")
}

model CourseLevel {
  id      String   @id @default(uuid())
  key     String   @unique
  label   String
  courses Course[]

  @@map("course_levels")
}

model Language {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  courses      Course[]
  userProfiles UserProfile[]

  @@map("languages")
}

model CourseStatus {
  id      String   @id @default(uuid())
  key     String   @unique
  label   String
  courses Course[]

  @@map("course_statuses")
}

model AccessType {
  id      String   @id @default(uuid())
  key     String   @unique
  label   String
  courses Course[]

  @@map("access_types")
}

model Course {
  id               String                  @id @default(uuid())
  authorId         String                  @map("author_id")
  categoryId       String                  @map("category_id")
  levelId          String                  @map("level_id")
  languageId       String                  @map("language_id")
  statusId         String                  @map("status_id")
  accessTypeId     String                  @map("access_type_id")
  title            String
  slug             String                  @unique
  subtitle         String?
  description      String
  coverImageUrl    String?                 @map("cover_image_url")
  bannerImageUrl   String?                 @map("banner_image_url")
  durationMinutes  Int?                    @map("duration_minutes")
  price            Decimal?                @db.Decimal(10, 2)
  ratingAverage    Decimal                 @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount      Int                     @default(0) @map("rating_count")
  publishedAt      DateTime?               @map("published_at")
  updatedContentAt DateTime?               @map("updated_content_at")
  seoTitle         String?                 @map("seo_title")
  seoDescription   String?                 @map("seo_description")
  seoKeywords      String?                 @map("seo_keywords")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  deletedAt        DateTime?               @map("deleted_at")
  certificates     Certificate[]
  coupons          Coupon[]
  objectives       CourseObjective[]
  prerequisitesOf  CoursePrerequisite[]    @relation("CourseRequires")
  requiredBy       CoursePrerequisite[]    @relation("RequiredByCourse")
  priceHistory     CoursePriceHistory[]
  courseProgress   CourseProgressSummary[]
  courseQuestions  CourseQuestion[]
  requirements     CourseRequirement[]
  resources        CourseResource[]
  tags             CourseTag[]
  accessType       AccessType              @relation(fields: [accessTypeId], references: [id])
  author           Author                  @relation(fields: [authorId], references: [id])
  category         Category                @relation(fields: [categoryId], references: [id])
  language         Language                @relation(fields: [languageId], references: [id])
  level            CourseLevel             @relation(fields: [levelId], references: [id])
  status           CourseStatus            @relation(fields: [statusId], references: [id])
  enrollments      Enrollment[]
  exams            Exam[]
  favorites        Favorite[]
  finalProject     CourseFinalProject?
  learningPaths    LearningPathCourse[]
  modules          Module[]
  payments         Payment[]
  reviews          Review[]

  @@map("courses")
}

model CourseObjective {
  id        String @id @default(uuid())
  courseId  String @map("course_id")
  text      String
  sortOrder Int    @default(0) @map("sort_order")
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_objectives")
}

model CourseRequirement {
  id        String @id @default(uuid())
  courseId  String @map("course_id")
  text      String
  sortOrder Int    @default(0) @map("sort_order")
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_requirements")
}

/// Relación formal curso-requiere-curso (además del texto libre de arriba).
model CoursePrerequisite {
  courseId         String @map("course_id")
  requiredCourseId String @map("required_course_id")
  course           Course @relation("CourseRequires", fields: [courseId], references: [id], onDelete: Cascade)
  requiredCourse   Course @relation("RequiredByCourse", fields: [requiredCourseId], references: [id], onDelete: Cascade)

  @@id([courseId, requiredCourseId])
  @@map("course_prerequisites")
}

/// Histórico de precio — necesario para mostrar precios anteriores de
/// forma honesta y auditable (y por requisitos legales de la UE).
model CoursePriceHistory {
  id            String    @id @default(uuid())
  courseId      String    @map("course_id")
  price         Decimal   @db.Decimal(10, 2)
  discountPrice Decimal?  @map("discount_price") @db.Decimal(10, 2)
  validFrom     DateTime  @map("valid_from")
  validTo       DateTime? @map("valid_to")
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_price_history")
}

model LearningPath {
  id            String               @id @default(uuid())
  title         String
  slug          String               @unique
  description   String?
  coverImageUrl String?              @map("cover_image_url")
  statusId      String               @map("status_id")
  price         Decimal?             @db.Decimal(10, 2)
  createdAt     DateTime             @default(now()) @map("created_at")
  courses       LearningPathCourse[]
  status        Status               @relation(fields: [statusId], references: [id])

  @@map("learning_paths")
}

model LearningPathCourse {
  learningPathId String       @map("learning_path_id")
  courseId       String       @map("course_id")
  sortOrder      Int          @default(0) @map("sort_order")
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@id([learningPathId, courseId])
  @@map("learning_path_courses")
}

model Module {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  lessons     Lesson[]
  exams       Exam[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("modules")
}

/// Catálogo de tipos de contenido — añadir uno nuevo (ej. "scorm") es
/// una fila, no una migración de columnas nullable adicionales.
model ContentType {
  id       String          @id @default(uuid())
  key      String          @unique
  label    String
  contents LessonContent[]
  lessons  Lesson[]

  @@map("content_types")
}

model Lesson {
  id              String           @id @default(uuid())
  moduleId        String           @map("module_id")
  title           String
  description     String?
  contentTypeId   String           @map("content_type_id")
  sortOrder       Int              @default(0) @map("sort_order")
  durationSeconds Int?             @map("duration_seconds")
  isPreview       Boolean          @default(false) @map("is_preview")
  createdAt       DateTime         @default(now()) @map("created_at")
  questions       CourseQuestion[]
  exams           Exam[]
  blocks          LessonBlock[]
  content         LessonContent?
  exercise        LessonExercise?
  exercises       Exercise[]
  pedagogy            LessonPedagogy?
  exerciseSubmissions ExerciseSubmission[]
  notes           LessonNote[]
  progress        LessonProgress[]
  resources       LessonResource[]
  contentType     ContentType      @relation(fields: [contentTypeId], references: [id])
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

/// Una tabla de contenido por lección, con `metadata` JSON para los
/// atributos genuinamente distintos entre tipos (proveedor de streaming,
/// transcripción, etc.). Es la única parte del esquema donde se usa JSON,
/// de forma deliberada — ver razonamiento en el documento de arquitectura.
model LessonContent {
  id            String      @id @default(uuid())
  lessonId      String      @unique @map("lesson_id")
  contentTypeId String      @map("content_type_id")
  body          String?
  externalUrl   String?     @map("external_url")
  metadata      Json?
  contentType   ContentType @relation(fields: [contentTypeId], references: [id])
  lesson        Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_contents")
}

model LessonExercise {
  id                String  @id @default(uuid())
  lessonId          String  @unique @map("lesson_id")
  instructions      String
  expectsSubmission Boolean @default(false) @map("expects_submission")
  maxScore          Int?    @map("max_score")
  lesson            Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_exercises")
}

/// Notas personales del alumno sobre una lección concreta. Tabla nueva,
/// aislada — no toca ningún modelo existente — para la Fase 5
/// (experiencia de aprendizaje). Una nota por alumno y lección.
model LessonNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_notes")
}

model ResourceType {
  id        String     @id @default(uuid())
  key       String     @unique
  label     String
  resources Resource[]

  @@map("resource_types")
}

model Resource {
  id             String           @id @default(uuid())
  title          String
  fileUrl        String           @map("file_url")
  resourceTypeId String           @map("resource_type_id")
  fileSizeBytes  Int?             @map("file_size_bytes")
  uploadedById   String?          @map("uploaded_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  courses        CourseResource[]
  lessons        LessonResource[]
  resourceType   ResourceType     @relation(fields: [resourceTypeId], references: [id])
  uploadedBy     User?            @relation(fields: [uploadedById], references: [id])

  @@map("resources")
}

model LessonResource {
  lessonId   String   @map("lesson_id")
  resourceId String   @map("resource_id")
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([lessonId, resourceId])
  @@map("lesson_resources")
}

model CourseResource {
  courseId   String   @map("course_id")
  resourceId String   @map("resource_id")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([courseId, resourceId])
  @@map("course_resources")
}

model QuestionType {
  id        String     @id @default(uuid())
  key       String     @unique
  label     String
  questions Question[]

  @@map("question_types")
}

model Question {
  id             String           @id @default(uuid())
  questionTypeId String           @map("question_type_id")
  statement      String
  explanation    String?
  categoryId     String?          @map("category_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  answers        ExamAnswer[]
  examQuestions  ExamQuestion[]
  options        QuestionOption[]
  category       Category?        @relation(fields: [categoryId], references: [id])
  questionType   QuestionType     @relation(fields: [questionTypeId], references: [id])

  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  matchKey   String?  @map("match_key")
  sortOrder  Int      @default(0) @map("sort_order")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model Exam {
  id                 String         @id @default(uuid())
  courseId           String?        @map("course_id")
  lessonId           String?        @map("lesson_id")
  moduleId           String?        @map("module_id")
  title              String
  passingScore       Decimal        @map("passing_score") @db.Decimal(5, 2)
  timeLimitMinutes   Int?           @map("time_limit_minutes")
  maxAttempts        Int?           @map("max_attempts")
  // Composición por bloques de ejercicio (Fase 6): si `randomizeSections`,
  // el orden de las secciones se baraja por intento.
  randomizeSections  Boolean        @default(false) @map("randomize_sections")
  createdAt          DateTime       @default(now()) @map("created_at")
  attempts           ExamAttempt[]
  parts              ExamPart[]
  questions          ExamQuestion[]
  sections           ExamSection[]
  course             Course?        @relation(fields: [courseId], references: [id])
  lesson             Lesson?        @relation(fields: [lessonId], references: [id])
  module             Module?        @relation(fields: [moduleId], references: [id])

  @@map("exams")
}

// Composición de examen (Fase 6): una sección referencia un `Exercise`
// (Reading/Writing/Listening/Speaking) con su PESO en la nota final y un
// tiempo opcional por sección. Reutiliza el motor de ejercicios; no
// duplica la lógica de preguntas.
model ExamSection {
  id               String   @id @default(uuid())
  examId           String   @map("exam_id")
  exerciseId       String   @map("exercise_id")
  weight           Decimal  @default(1) @db.Decimal(5, 2)
  timeLimitMinutes Int?     @map("time_limit_minutes")
  order            Int      @default(0)
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  exercise         Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([exerciseId])
  @@map("exam_sections")
}

model ExamPart {
  id        String         @id @default(uuid())
  examId    String         @map("exam_id")
  skill     String
  part      Int
  title     String
  createdAt DateTime       @default(now()) @map("created_at")
  exercises ExamExercise[]
  exam      Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_parts")
}

model ExamExercise {
  id        String   @id @default(uuid())
  partId    String   @map("part_id")
  type      String
  title     String?
  content   Json
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  part      ExamPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@map("exam_exercises")
}

model ExamQuestion {
  examId     String   @map("exam_id")
  questionId String   @map("question_id")
  sortOrder  Int      @default(0) @map("sort_order")
  points     Decimal  @default(1) @db.Decimal(5, 2)
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
  @@map("exam_questions")
}

model ExamAttempt {
  id               String       @id @default(uuid())
  examId           String       @map("exam_id")
  userId           String       @map("user_id")
  startedAt        DateTime     @default(now()) @map("started_at")
  submittedAt      DateTime?    @map("submitted_at")
  score            Decimal?     @db.Decimal(5, 2)
  passed           Boolean?
  timeSpentSeconds Int?         @map("time_spent_seconds")
  answers          ExamAnswer[]
  exam             Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exam_attempts")
}

model ExamAnswer {
