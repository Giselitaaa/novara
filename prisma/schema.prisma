  template         CertificateTemplate          @relation(fields: [templateId], references: [id])
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model CertificateVerificationLog {
  id            String      @id @default(uuid())
  certificateId String      @map("certificate_id")
  verifiedAt    DateTime    @default(now()) @map("verified_at")
  ipAddress     String?     @map("ip_address")
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@map("certificate_verification_logs")
}

model EnrollmentSource {
  id          String       @id @default(uuid())
  key         String       @unique
  label       String
  enrollments Enrollment[]

  @@map("enrollment_sources")
}

/// Pieza central que faltaba modelar de forma explícita: conecta alumno
/// y curso, con origen y validez propios.
model Enrollment {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  courseId   String           @map("course_id")
  sourceId   String           @map("source_id")
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  expiresAt  DateTime?        @map("expires_at")
  status     String           @default("activo")
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source     EnrollmentSource @relation(fields: [sourceId], references: [id])
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  lessonId            String    @map("lesson_id")
  status              String    @default("no_iniciado")
  watchedSeconds      Int       @default(0) @map("watched_seconds")
  lastPositionSeconds Int       @default(0) @map("last_position_seconds")
  isFavorite          Boolean   @default(false) @map("is_favorite")
  completedAt         DateTime? @map("completed_at")
  lastActivityAt      DateTime  @updatedAt @map("last_activity_at")
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

/// Tabla de resumen/caché — el detalle real vive en LessonProgress.
model CourseProgressSummary {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  courseId        String   @map("course_id")
  percentComplete Decimal  @default(0) @map("percent_complete") @db.Decimal(5, 2)
  lastActivityAt  DateTime @updatedAt @map("last_activity_at")
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_progress_summaries")
}

model PaymentMethod {
  id       String    @id @default(uuid())
  key      String    @unique
  label    String
  payments Payment[]

  @@map("payment_methods")
}

model PaymentStatus {
  id       String                 @id @default(uuid())
  key      String                 @unique
  label    String
  history  PaymentStatusHistory[] @relation("ToStatus")
  payments Payment[]
}

model Payment {
  id                String                 @id @default(uuid())
  userId            String                 @map("user_id")
  courseId          String?                @map("course_id")
  learningPathId    String?                @map("learning_path_id")
  paymentMethodId   String                 @map("payment_method_id")
  amount            Decimal                @db.Decimal(10, 2)
  currency          String                 @default("EUR")
  statusId          String                 @map("status_id")
  proofFileUrl      String?                @map("proof_file_url")
  adminNotes        String?                @map("admin_notes")
  reviewedById      String?                @map("reviewed_by")
  reviewedAt        DateTime?              @map("reviewed_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  affiliateReferral AffiliateReferral?
  invoice           Invoice?
  coupons           PaymentCoupon[]
  statusHistory     PaymentStatusHistory[]
  course            Course?                @relation(fields: [courseId], references: [id])
  paymentMethod     PaymentMethod          @relation(fields: [paymentMethodId], references: [id])
  reviewedBy        User?                  @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  status            PaymentStatus          @relation(fields: [statusId], references: [id])
  user              User                   @relation(fields: [userId], references: [id])
  refunds           Refund[]

  @@map("payments")
}

/// Cada cambio de estado queda registrado — imprescindible para soporte
/// y para poder responder "¿cuándo y por qué se rechazó este pago?".
model PaymentStatusHistory {
  id           String        @id @default(uuid())
  paymentId    String        @map("payment_id")
  fromStatusId String?       @map("from_status_id")
  toStatusId   String        @map("to_status_id")
  changedById  String?       @map("changed_by")
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at")
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  toStatus     PaymentStatus @relation("ToStatus", fields: [toStatusId], references: [id])

  @@map("payment_status_history")
}

model Invoice {
  id             String   @id @default(uuid())
  paymentId      String   @unique @map("payment_id")
  invoiceNumber  String   @unique @map("invoice_number")
  issuedAt       DateTime @default(now()) @map("issued_at")
  pdfUrl         String?  @map("pdf_url")
  billingName    String   @map("billing_name")
  billingTaxId   String?  @map("billing_tax_id")
  billingAddress String?  @map("billing_address")
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Refund {
  id            String    @id @default(uuid())
  paymentId     String    @map("payment_id")
  amount        Decimal   @db.Decimal(10, 2)
  reason        String?
  status        String    @default("pendiente")
  requestedAt   DateTime  @default(now()) @map("requested_at")
  processedAt   DateTime? @map("processed_at")
  processedById String?   @map("processed_by")
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  processedBy   User?     @relation("RefundProcessor", fields: [processedById], references: [id])

  @@map("refunds")
}

model Coupon {
  id                 String          @id @default(uuid())
  code               String          @unique
  discountType       String          @map("discount_type")
  discountValue      Decimal         @map("discount_value") @db.Decimal(10, 2)
  validFrom          DateTime        @map("valid_from")
  validTo            DateTime?       @map("valid_to")
  maxUses            Int?            @map("max_uses")
  timesUsed          Int             @default(0) @map("times_used")
  applicableCourseId String?         @map("applicable_course_id")
  applicableCourse   Course?         @relation(fields: [applicableCourseId], references: [id])
  payments           PaymentCoupon[]

  @@map("coupons")
}

model PaymentCoupon {
  paymentId String  @map("payment_id")
  couponId  String  @map("coupon_id")
  coupon    Coupon  @relation(fields: [couponId], references: [id])
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@id([paymentId, couponId])
  @@map("payment_coupons")
}

model EmailTemplate {
  id       String  @id @default(uuid())
  key      String  @unique
  subject  String
  bodyHtml String  @map("body_html")
  isActive Boolean @default(true) @map("is_active")

  @@map("email_templates")
}

model EmailLog {
  id                String    @id @default(uuid())
  userId            String?   @map("user_id")
  templateKey       String    @map("template_key")
  sentTo            String    @map("sent_to")
  status            String    @default("pendiente")
  providerMessageId String?   @map("provider_message_id")
  sentAt            DateTime? @map("sent_at")
  user              User?     @relation(fields: [userId], references: [id])

  @@map("email_logs")
}

/// Mismo evento de negocio, dos canales: email (arriba) y esto, dentro
/// de la propia plataforma (campanita de notificaciones).
model Notification {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  type              String
  title             String
  body              String
  isRead            Boolean  @default(false) @map("is_read")
  createdAt         DateTime @default(now()) @map("created_at")
  relatedEntityType String?  @map("related_entity_type")
  relatedEntityId   String?  @map("related_entity_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Badge {
  id                  String        @id @default(uuid())
  name                String
  description         String?
  iconUrl             String?       @map("icon_url")
  criteriaDescription String?       @map("criteria_description")
  achievements        Achievement[]
  users               UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId    String   @map("user_id")
  badgeId   String   @map("badge_id")
  awardedAt DateTime @default(now()) @map("awarded_at")
  badge     Badge    @relation(fields: [badgeId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

/// Histórico de experiencia, no un campo único sumado — permite auditar
/// y mostrar una línea de tiempo de progreso real.
model XPTransaction {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  amount            Int
  reason            String
  relatedEntityType String?  @map("related_entity_type")
  relatedEntityId   String?  @map("related_entity_id")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_transactions")
}

model Streak {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  currentStreakDays Int       @default(0) @map("current_streak_days")
  longestStreakDays Int       @default(0) @map("longest_streak_days")
  lastActivityDate  DateTime? @map("last_activity_date")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

/// Definición/regla del logro. Distinto de Badge (la recompensa visual).
model Achievement {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  badgeId     String? @map("badge_id")
  xpReward    Int     @default(0) @map("xp_reward")
  badge       Badge?  @relation(fields: [badgeId], references: [id])

  @@map("achievements")
}

/// Nivel del alumno por gamificación — no confundir con CourseLevel.
model UserLevel {
  id      String  @id @default(uuid())
  name    String
  minXp   Int     @map("min_xp")
  iconUrl String? @map("icon_url")

  @@map("user_levels")
}

model Favorite {
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@map("favorites")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  rating    Int
  comment   String?
  statusId  String   @map("status_id")
  createdAt DateTime @default(now()) @map("created_at")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    Status   @relation(fields: [statusId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("reviews")
}

/// Historial del propio alumno (distinto del AuditLog de administración).
model ActivityLog {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  eventType         String   @map("event_type")
  description       String
  relatedEntityType String?  @map("related_entity_type")
  relatedEntityId   String?  @map("related_entity_id")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model CourseQuestion {
  id         String                 @id @default(uuid())
  courseId   String                 @map("course_id")
  lessonId   String?                @map("lesson_id")
  userId     String                 @map("user_id")
  body       String
  statusId   String                 @map("status_id")
  categoryId String?                @map("category_id")
  createdAt  DateTime               @default(now()) @map("created_at")
  answers    CourseQuestionAnswer[]
  category   Category?              @relation("CourseQuestionCategory", fields: [categoryId], references: [id])
  course     Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson     Lesson?                @relation(fields: [lessonId], references: [id])
  status     Status                 @relation(fields: [statusId], references: [id])
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("course_questions")
}

model CourseQuestionAnswer {
  id         String         @id @default(uuid())
  questionId String         @map("question_id")
  userId     String         @map("user_id")
  body       String
  createdAt  DateTime       @default(now()) @map("created_at")
  question   CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id])

  @@map("course_question_answers")
}

model SupportTicket {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  subject   String
  category  String
  statusId  String           @map("status_id")
  priority  String           @default("normal")
  createdAt DateTime         @default(now()) @map("created_at")
  messages  SupportMessage[]
  status    Status           @relation(fields: [statusId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model SupportMessage {
  id            String        @id @default(uuid())
  ticketId      String        @map("ticket_id")
  senderId      String        @map("sender_id")
  body          String
  attachmentUrl String?       @map("attachment_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  sender        User          @relation(fields: [senderId], references: [id])
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("global_settings")
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String    @map("image_url")
  linkUrl   String?   @map("link_url")
  position  String
  statusId  String    @map("status_id")
  sortOrder Int       @default(0) @map("sort_order")
  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")
  status    Status    @relation(fields: [statusId], references: [id])

  @@map("banners")
}

/// Permite componer la home desde el panel de admin sin desplegar código.
model HomePageBlock {
  id        String @id @default(uuid())
  blockType String @map("block_type")
  config    Json
  sortOrder Int    @default(0) @map("sort_order")
  statusId  String @map("status_id")
  status    Status @relation(fields: [statusId], references: [id])

  @@map("home_page_blocks")
}

model BlogPost {
  id             String    @id @default(uuid())
  authorId       String    @map("author_id")
  title          String
  slug           String    @unique
  coverImageUrl  String?   @map("cover_image_url")
  excerpt        String?
  body           String
  statusId       String    @map("status_id")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  author         User      @relation(fields: [authorId], references: [id])
  status         Status    @relation(fields: [statusId], references: [id])

  @@map("blog_posts")
}

/// Sistema de afiliados — Fase 6. Arquitectura completa desde ahora,
/// aunque el programa permanezca desactivado por defecto (interruptor
/// `affiliate_program_enabled` en `GlobalSetting`). Un usuario con
/// cuenta normal puede convertirse en afiliado; nada de esto interfiere
/// con el resto del modelo si el programa está apagado.
model Affiliate {
  id             String              @id @default(uuid())
  userId         String              @unique @map("user_id")
  code           String              @unique
  commissionRate Decimal             @default(10) @map("commission_rate") @db.Decimal(5, 2)
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  payouts        AffiliatePayout[]
  referrals      AffiliateReferral[]
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("affiliates")
}

/// Un referido concreto: alguien que se registró a través del enlace
/// de un afiliado. La comisión se calcula y confirma cuando (si)
/// ese referido completa una compra — no al registrarse.
model AffiliateReferral {
  id               String    @id @default(uuid())
  affiliateId      String    @map("affiliate_id")
  referredUserId   String    @unique @map("referred_user_id")
  paymentId        String?   @unique @map("payment_id")
  commissionAmount Decimal?  @map("commission_amount") @db.Decimal(10, 2)
  status           String    @default("pendiente")
  createdAt        DateTime  @default(now()) @map("created_at")
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  payment          Payment?  @relation(fields: [paymentId], references: [id])
  referredUser     User      @relation(fields: [referredUserId], references: [id], onDelete: Cascade)

  @@map("affiliate_referrals")
}

/// Historial de pagos realizados a un afiliado por sus comisiones
/// confirmadas — mismo patrón de histórico explícito que `Payment`.
model AffiliatePayout {
  id          String    @id @default(uuid())
  affiliateId String    @map("affiliate_id")
  amount      Decimal   @db.Decimal(10, 2)
  status      String    @default("pendiente")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_payouts")
}

model AuditLog {
  id               String   @id @default(uuid())
  actorId          String   @map("actor_id")
  action           String
  targetEntityType String   @map("target_entity_type")
  targetEntityId   String   @map("target_entity_id")
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")
  actor            User     @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model LessonBlock {
  id        String         @id @default(uuid())
  lessonId  String         @map("lesson_id")
  type      String
  order     Int            @default(0)
  title     String?
  content   String?
  imageUrl  String?        @map("image_url")
  videoUrl  String?        @map("video_url")
  audioUrl  String?        @map("audio_url")
  // Contenido estructurado por tipo (galería de imágenes, ítems de resumen,
  // variante de nota, metadatos de PDF/recurso…). Validado en la capa de
  // aplicación según `type`. Los bloques simples siguen usando las columnas.
  data      Json?
  // Bloque de flashcards: referencia a un mazo reutilizable (biblioteca).
  deckId    String?        @map("deck_id")
  createdAt DateTime       @default(now()) @map("created_at")
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  deck      FlashcardDeck? @relation(fields: [deckId], references: [id], onDelete: SetNull)

  @@index([deckId])
  @@map("lesson_blocks")
}

// Plantilla de lección (mejora 3.5): guarda el ESQUELETO de bloques (tipos y
// orden, sin el contenido concreto) para reutilizarlo al crear lecciones con
// estructura repetitiva. Global (compartida entre administradores).
model LessonTemplate {
  id        String   @id @default(uuid())
  name      String
  blocks    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("lesson_templates")
}

// ─────────────────────────────────────────────────────────────
// Flashcards (Fase 3). Un mazo (FlashcardDeck) es una entidad de
// primera clase reutilizable (biblioteca): puede vivir por sí solo en
// el panel y, más adelante, referenciarse desde un bloque de lección.
// El audio de pronunciación se genera con la capa de voz (modules/voice).
// ─────────────────────────────────────────────────────────────

model FlashcardDeck {
  id          String      @id @default(uuid())
  title       String
  description String?
  language    String?
  authorId    String      @map("author_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  author      User          @relation(fields: [authorId], references: [id])
  cards       Flashcard[]
  lessonBlocks LessonBlock[]

  @@index([authorId])
  @@map("flashcard_decks")
}

model Flashcard {
  id            String        @id @default(uuid())
  deckId        String        @map("deck_id")
  term          String
  translation   String
  explanation   String?
  example       String?
  category      String?
  level         String?
  pronunciation String?
  ipa           String?
  audioUrl      String?       @map("audio_url")
  notes         String?
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deck          FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId])
  @@map("flashcards")
}

// ─────────────────────────────────────────────────────────────
// Ejercicios (Fase 5). Modelo flexible: una `Exercise` pertenece a las 4
// categorías (reading/writing/listening/speaking); su `config` (JSON)
// guarda lo específico de cada una (texto base, audio+transcripción,
// rúbrica de writing, escenario de speaking). Las preguntas de Reading/
// Listening se guardan como `ExerciseQuestion` con la definición completa
// en `data` (motor de tipos reutilizable, ver modules/exercises/shared).
// ─────────────────────────────────────────────────────────────

model Exercise {
  id           String             @id @default(uuid())
  lessonId     String             @map("lesson_id")
  category     String
  title        String
  instructions String?
  config       Json?
  sortOrder    Int                @default(0) @map("sort_order")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  lesson       Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions    ExerciseQuestion[]
  examSections ExamSection[]
  attempts     ExerciseAttempt[]

  @@index([lessonId])
  @@map("exercises")
}

// Intento de un alumno en un ejercicio (Fase 5, consumo): guarda la nota,
// aciertos y las respuestas, para seguimiento del alumno y analítica.
model ExerciseAttempt {
  id                String   @id @default(uuid())
  exerciseId        String   @map("exercise_id")
  userId            String   @map("user_id")
  score             Int
  correctCount      Int      @map("correct_count")
  total             Int
  needsManualReview Boolean  @default(false) @map("needs_manual_review")
  responses         Json?
  createdAt         DateTime @default(now()) @map("created_at")
  exercise          Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@index([userId])
  @@map("exercise_attempts")
}

model ExerciseQuestion {
  id         String   @id @default(uuid())
  exerciseId String   @map("exercise_id")
  order      Int      @default(0)
  kind       String
  data       Json
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@map("exercise_questions")
}

// ─────────────────────────────────────────────────────────────
// Estándar NOVARA — adiciones de la iteración más avanzada
// (reconstruidas a partir del uso real en el código de src/):
//   - LessonPedagogy: los 10 puntos pedagógicos por lección
//   - ExerciseSubmission: entrega de ejercicio + corrección IA
//   - CourseFinalProject + Submission: proyecto final por curso
// ─────────────────────────────────────────────────────────────

model LessonPedagogy {
  id              String   @id @default(uuid())
  lessonId        String   @unique @map("lesson_id")
  objective       String?
  examples        String[]
  commonMistakes  String[] @map("common_mistakes")
  visualSchemaUrl String?  @map("visual_schema_url")
  mindMapUrl      String?  @map("mind_map_url")
  summary         String?
  reviewPrompts   String[] @map("review_prompts")
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_pedagogy")
}

model ExerciseSubmission {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  lessonId    String    @map("lesson_id")
  content     String
  status      String    @default("pendiente")
  aiScore     Decimal?  @map("ai_score") @db.Decimal(5, 2)
  aiFeedback  String?   @map("ai_feedback")
  submittedAt DateTime  @default(now()) @map("submitted_at")
  correctedAt DateTime? @map("corrected_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("exercise_submissions")
}

model CourseFinalProject {
  id           String                         @id @default(uuid())
  courseId     String                         @unique @map("course_id")
  title        String
  instructions String
  course       Course                         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions  CourseFinalProjectSubmission[]

  @@map("course_final_projects")
}

model CourseFinalProjectSubmission {
  id             String             @id @default(uuid())
  finalProjectId String             @map("final_project_id")
  userId         String             @map("user_id")
  content        String
  status         String             @default("pendiente")
  feedback       String?
  submittedAt    DateTime           @default(now()) @map("submitted_at")
  finalProject   CourseFinalProject @relation(fields: [finalProjectId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([finalProjectId, userId])
  @@map("course_final_project_submissions")
}
